<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Paul Gauthier{% endblock %}</title>

    <link rel="stylesheet" href="https://bootswatch.com/5/morph/bootstrap.min.css">

    {% block stylesheets %}{% endblock %}

    <style>
        :root {
            --container2-bg-light: #ffffff;
            --container2-bg-dark: #1e1e1e;
            --name-color-light: #000000;
            --name-color-dark: #ffffff;
        }
        :root[data-bs-theme="light"] {
            --container2-bg: var(--container2-bg-light);
            --name-color: var(--name-color-light);
        }
        :root[data-bs-theme="dark"] {
            --container2-bg: var(--container2-bg-dark);
            --name-color: var(--name-color-dark);
        }

        footer {
            background-color: #333;
            color: #fff;
            text-align: center;
            padding: 20px;
            width: 100%;
            position: relative;
        }
        footer a {
            color: #ddd;
            text-decoration: none;
            margin: 0 10px;
        }
        footer a:hover {
            color: #fff;
        }
        footer p {
            margin: 10px 0;
            font-size: 14px;
        }
        footer .social-icons {
            margin-top: 10px;
        }
        footer .social-icons a {
            font-size: 18px;
            margin: 0 15px;
        }
    </style>
</head>

<body>
<nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Eportfolio</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarColor02" aria-controls="navbarColor02"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarColor02">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="/blog">
                        Home <span class="visually-hidden">(current)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/loisirs">Loisirs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/cv">CV</a>
                </li>

                <!-- Dropdown Bootstrap responsive -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="competenceDropdown"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Compétences
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="competenceDropdown">
                        <li><a class="dropdown-item" href="/com#SAE2.03">Administrer</a></li>
                        <li><a class="dropdown-item" href="/com#SAE1.03">Connecter</a></li>
                        <li><a class="dropdown-item" href="/com#SAE1.05">Programmer</a></li>
                    </ul>
                </li>
            </ul>

            <form class="d-flex">
                <button class="btn btn-secondary my-2 my-sm-0" type="button" id="btnSwitch">
                    mode
                </button>
            </form>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

<footer>
    <p>&copy; 2025 Mon Site Web - Tous droits réservés.</p>
    <div class="social-icons">
        <a href="#">Linkedin</a>
        <a href="#">Instagram</a>
        <a href="https://github.com/Paul-Gauthier42">GitHub</a>
    </div>
    <p><a href="#">Mentions légales</a> | <a href="#">Politique de confidentialité</a></p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

<script>
    const btn = document.getElementById('btnSwitch');
    btn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-bs-theme', newTheme);
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
