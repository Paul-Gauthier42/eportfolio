{% extends 'base.html.twig' %}

{% block title %}Paul Gauthier{% endblock %}

{% block body %}
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Homme</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
