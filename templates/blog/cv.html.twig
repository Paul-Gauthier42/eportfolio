{% extends 'base.html.twig' %}

{% block title %}Paul Gauthier{% endblock %}

{% block body %}
<head>
  <meta charset="UTF-8">
  <title>Téléchargement</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
    }

    .btn-download {
      background-color: #4CAF50;
      color: white;
      padding: 15px 30px;
      text-decoration: none;
      font-size: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      transition: 0.3s;
      margin-top: 100rem;
    }

    .btn-download:hover {
      background-color: #45a049;
      box-shadow: 0 6px 14px rgba(0,0,0,0.4);
    }
    .container{
        margin-top: 11rem;
        margin-bottom: 12rem;
    }
    .h1{
        margin-top:20px;
    }
  </style>
</head>
<body>

  <h1 class=h1 >⬇️Retrouver mon CV⬇️</h1>

  <div class = container>
  <a class="btn-download" href="fichier.pdf" download>
    Télécharger mon CV
  </a>
  </div>
</body>




{% endblock %}